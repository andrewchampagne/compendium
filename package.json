{
  "name": "compendium",
  "version": "0.1.0",
  "private": true,
  "description": "Compendium — AI flashcard maker. Ingest slides/docs, study, and edit cards via chat.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "backend": "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --port 8765 --reload",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "^45.0.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
